<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="5dp"
    android:layout_marginBottom="5dp"
    android:background="@drawable/bg_result"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <!-- Badge du nom du groupe -->
    <TextView
        android:id="@+id/tvGroupName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_input"
        android:minWidth="48dp"
        android:gravity="center"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp"
        android:textColor="@color/navy"
        android:textSize="15sp"
        android:textStyle="bold"
        tools:text="G1" />

    <!-- Détails des places et liste d'attente -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Statut d'inscription (ex: 1 / 1 inscrits) -->
        <TextView
            android:id="@+id/tvGroupStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/label"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="1 / 1 inscrits" />

        <!-- Ligne avec badge statut et attente -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="Complet"
                tools:textColor="@color/danger_red" />

            <TextView
                android:id="@+id/tvWaitingBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@color/badge_waiting_bg"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp"
                android:textColor="@color/badge_waiting"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="2 en attente"
                tools:visibility="visible" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bouton Modifier -->
    <ImageButton
        android:id="@+id/btnEditGroup"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/btn_modifier"
        android:src="@drawable/ic_edit"
        app:tint="@color/teal" />

    <!-- Bouton Supprimer -->
    <ImageButton
        android:id="@+id/btnDeleteGroup"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/btn_supprimer"
        android:src="@drawable/ic_delete"
        app:tint="@color/danger_red" />

</LinearLayout>
