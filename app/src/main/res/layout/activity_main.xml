<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity">

    <!-- Contenu principal déroulant -->
    <ScrollView
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_screen"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ===== En-tête avec bouton Hamburger ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/navy"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp">

                <ImageButton
                    android:id="@+id/btnMenu"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/desc_drawer_toggle"
                    android:src="@drawable/ic_menu_hamburger" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvTitre"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/titre"
                        android:textColor="@color/white"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSousTitre"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/sous_titre"
                        android:textColor="@color/subtitle"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Compteurs des places disponibles -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:orientation="horizontal"
                android:weightSum="3">

                <TextView
                    android:id="@+id/tvPlacesG1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_result"
                    android:gravity="center"
                    android:padding="8dp"
                    android:text="G1 : 1 place"
                    android:textColor="@color/label"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvPlacesG2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="4dp"
                    android:background="@drawable/bg_result"
                    android:gravity="center"
                    android:padding="8dp"
                    android:text="G2 : 8 places"
                    android:textColor="@color/label"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvPlacesG3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_result"
                    android:gravity="center"
                    android:padding="8dp"
                    android:text="G3 : 8 places"
                    android:textColor="@color/label"
                    android:textSize="11sp" />

            </LinearLayout>

            <!-- ===== Contenu du formulaire ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Nom -->
                <TextView
                    style="@style/Form.Label"
                    android:labelFor="@id/etNom"
                    android:text="@string/label_nom" />

                <EditText
                    android:id="@+id/etNom"
                    style="@style/Form.Field"
                    android:hint="@string/hint_nom"
                    android:importantForAutofill="no"
                    android:inputType="textPersonName|textCapWords" />

                <!-- Prénom -->
                <TextView
                    style="@style/Form.Label"
                    android:labelFor="@id/etPrenom"
                    android:text="@string/label_prenom" />

                <EditText
                    android:id="@+id/etPrenom"
                    style="@style/Form.Field"
                    android:hint="@string/hint_prenom"
                    android:importantForAutofill="no"
                    android:inputType="textPersonName|textCapWords" />

                <!-- Âge -->
                <TextView
                    style="@style/Form.Label"
                    android:labelFor="@id/etAge"
                    android:text="@string/label_age" />

                <EditText
                    android:id="@+id/etAge"
                    style="@style/Form.Field"
                    android:hint="@string/hint_age"
                    android:importantForAutofill="no"
                    android:inputType="number" />

                <!-- Groupe -->
                <TextView
                    style="@style/Form.Label"
                    android:labelFor="@id/spGroupe"
                    android:text="@string/label_groupe" />

                <Spinner
                    android:id="@+id/spGroupe"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_input"
                    android:entries="@array/groupes"
                    android:paddingStart="4dp"
                    android:paddingEnd="8dp" />

                <!-- Support de test -->
                <TextView
                    style="@style/Form.Label"
                    android:layout_marginTop="24dp"
                    android:text="@string/label_support" />

                <RadioGroup
                    android:id="@+id/rgSupport"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rbEmulateur"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:buttonTint="@color/teal"
                        android:checked="true"
                        android:minHeight="48dp"
                        android:text="@string/emulateur"
                        android:textColor="@color/label"
                        android:textSize="13sp" />

                    <RadioButton
                        android:id="@+id/rbTelephone"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:buttonTint="@color/teal"
                        android:minHeight="48dp"
                        android:text="@string/telephone"
                        android:textColor="@color/label"
                        android:textSize="13sp" />
                </RadioGroup>

                <!-- Confirmation -->
                <CheckBox
                    android:id="@+id/cbConfirmation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:buttonTint="@color/teal"
                    android:minHeight="48dp"
                    android:text="@string/confirmation"
                    android:textColor="@color/label"
                    android:textSize="13sp" />

                <!-- Boutons -->
                <Button
                    android:id="@+id/btnAfficher"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_btn_primary"
                    android:backgroundTint="@null"
                    android:text="@string/btn_afficher"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/btnEffacer"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_btn_outline"
                    android:backgroundTint="@null"
                    android:text="@string/btn_effacer"
                    android:textAllCaps="false"
                    android:textColor="@color/teal"
                    android:textSize="15sp" />

                <!-- Zone de récapitulatif -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_result"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/zone_recap"
                        android:textColor="@color/label"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvResultat"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/resultat_initial"
                        android:textColor="@color/result_text"
                        android:textSize="13sp" />
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Menu latéral (Navigation Drawer) -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:fitsSystemWindows="true"
        app:headerLayout="@layout/drawer_header"
        app:itemIconTint="@color/teal"
        app:itemTextColor="@color/label"
        app:menu="@menu/drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>
