<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="16dp"
    android:paddingEnd="20dp"
    android:paddingBottom="12dp">

    <!-- Nom du groupe -->
    <TextView
        style="@style/Form.Label"
        android:layout_marginTop="0dp"
        android:text="@string/label_group_name" />

    <EditText
        android:id="@+id/etDialogGroupName"
        style="@style/Form.Field"
        android:hint="@string/hint_group_name"
        android:importantForAutofill="no"
        android:inputType="textCapCharacters|textNoSuggestions" />

    <!-- Capacité maximale -->
    <TextView
        style="@style/Form.Label"
        android:layout_marginTop="16dp"
        android:text="@string/label_group_capacity" />

    <EditText
        android:id="@+id/etDialogGroupCapacity"
        style="@style/Form.Field"
        android:hint="@string/hint_group_capacity"
        android:importantForAutofill="no"
        android:inputType="number" />

</LinearLayout>
